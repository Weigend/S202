<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.Group?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Polygon?>
<Pane prefHeight="400.0" prefWidth="600.0"
      styleClass="splash-root"
      stylesheets="@splash.css"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="io.softwareecg.wfx.platform.core.ProgressController">

    <!-- Artwork deliberately contains no copy: all product data stays live and replaceable. -->
    <ImageView fitHeight="400.0" fitWidth="600.0" mouseTransparent="true"
               preserveRatio="false" smooth="true">
        <Image url="@splash-background.png"/>
    </ImageView>
    <Pane prefHeight="400.0" prefWidth="600.0" mouseTransparent="true"
          styleClass="splash-shade"/>

    <!-- The same pointy-top hexagon and inner circle used by the About dialog. -->
    <Group layoutX="34.0" layoutY="75.0" mouseTransparent="true">
        <Polygon points="30,0,55.98,15,55.98,45,30,60,4.02,45,4.02,15"
                 fill="TRANSPARENT" stroke="#ffd54f" strokeWidth="3.5"/>
        <Circle centerX="30.0" centerY="30.0" radius="11.4"
                fill="TRANSPARENT" stroke="#ffd54f" strokeWidth="3.0"/>
    </Group>

    <Label layoutX="113.0" layoutY="72.0"
           text="S202 Code Analyzer"
           styleClass="splash-title"/>
    <Label layoutX="117.0" layoutY="111.0"
           text="Multi-language architecture visualization"
           styleClass="splash-subtitle"/>
    <Label layoutX="117.0" layoutY="139.0"
           text="v${project.version}"
           styleClass="splash-version"/>

    <ProgressBar fx:id="progressBar" id="splash-progress-bar"
                 layoutX="34.0" layoutY="343.0" prefWidth="532.0"
                 progress="0.0" styleClass="splash-progress-bar"/>
    <Label fx:id="progressText" id="splash-progress-text"
           layoutX="34.0" layoutY="363.0" prefWidth="532.0"
           text="Starting S202..."
           styleClass="splash-progress-text"/>
</Pane>
